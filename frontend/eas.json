{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://netzeal-app-1.onrender.com/api/v1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "969312048318-4ka0pqht3npf3j6ohqrevfj6jvvno9js.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "969312048318-5v8pfjhgiep7l1basajbchic6mg1bb6t.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID": "969312048318-4ka0pqht3npf3j6ohqrevfj6jvvno9js.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://netzeal-app-1.onrender.com/api/v1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "969312048318-4ka0pqht3npf3j6ohqrevfj6jvvno9js.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "969312048318-5v8pfjhgiep7l1basajbchic6mg1bb6t.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID": "969312048318-4ka0pqht3npf3j6ohqrevfj6jvvno9js.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
