{
  "expo": {
    "name": "NetZeal",
    "slug": "netzeal",
    "scheme": "netzeal",
    "version": "1.0.0",
    "owner": "krishanmohan",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3E3E3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "expoClient": {
        "googleOAuth": {
          "expoClientId": "969312048318-4ka0pqht3npf3j6ohqrevfj6jvvno9js.apps.googleusercontent.com"
        }
      },
      "eas": {
        "projectId": "108fe6ee-3f41-4594-88c4-755f0f182add"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netzeal.app"
    },
    "android": {
      "backgroundColor": "#FFFFFF",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/app-icon.png",
        "backgroundColor": "#E3E3E3"
      },
      "package": "com.netzeal.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "build": {
        "babel": {
          "include": []
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/108fe6ee-3f41-4594-88c4-755f0f182add"
    }
  }
}
