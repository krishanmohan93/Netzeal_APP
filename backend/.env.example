# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=90
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# NVIDIA Integrate Configuration (OpenAI-compatible, optional fallback)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=deepseek-ai/deepseek-r1

# Legacy AI keys (optional, retained for backward compatibility)
DEEPSEEK_API_KEY=
GROQ_API_KEY=your-groq-api-key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
AI_PRIMARY_PROVIDER=groq
AI_MAX_RESPONSE_TOKENS=320
AI_REQUEST_TIMEOUT_SECONDS=30

# Qdrant Cloud Configuration (Vector Database for Semantic Search)
# Get your credentials from: https://cloud.qdrant.io/
# 1. Create a free cluster or paid cluster
# 2. Copy the cluster URL (format: https://xxx-xxx-xxx.qdrant.io)
# 3. Generate an API key from the dashboard
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=netzeal_posts

# Cloudinary Configuration (Media Storage - Instagram-like uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Admin Configuration (choose one)
FIREBASE_SERVICE_ACCOUNT_KEY=/absolute/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Application Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=NetZeal
DEBUG=False
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_SIZE_BYTES=10485760
GZIP_ENABLED=True
GZIP_MINIMUM_SIZE_BYTES=1024
FEED_CACHE_TTL_SECONDS=30
PROFILE_CACHE_TTL_SECONDS=45
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
RATE_LIMIT_KEY_PREFIX=rl
AUTH_RATE_LIMIT_PER_MINUTE=10
POST_CREATE_RATE_LIMIT_PER_MINUTE=20
ENGAGEMENT_RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=45
LIVE_STREAMING_ENABLED=False
SEMANTIC_FEATURES_ENABLED=True
EXPERIMENTAL_AI_ENABLED=False
CORS_ORIGINS=https://your-frontend-domain.com
ALLOWED_HOSTS=your-api-domain.com
FORCE_HTTPS=True
SECURE_RESPONSE_HEADERS=True
HSTS_MAX_AGE=31536000
FRONTEND_BASE_URL=https://your-frontend-domain.com

# SMTP (for verification and password reset emails)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_USE_TLS=True
